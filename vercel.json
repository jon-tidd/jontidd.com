{
  "redirects": [
    {
      "source": "/familyhistory",
      "destination": "/familyhistory/",
      "permanent": true
    },
    {
      "source": "/sitescreener",
      "destination": "/sitescreener/",
      "permanent": true
    },
    {
      "source": "/floorplan",
      "destination": "/floorplan/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/floorplan/api/:path*",
      "destination": "/api/floorplan/:path*"
    },
    {
      "source": "/battleplan",
      "destination": "https://nova-plan-omega.vercel.app/"
    },
    {
      "source": "/battleplan/api/:path*",
      "destination": "https://nova-plan-omega.vercel.app/api/:path*"
    },
    {
      "source": "/battleplan/:path*",
      "destination": "https://nova-plan-omega.vercel.app/:path*"
    },
    {
      "source": "/projectplan",
      "destination": "https://nova-plan-omega.vercel.app/projectplan"
    },
    {
      "source": "/projectplan/api/:path*",
      "destination": "https://nova-plan-omega.vercel.app/api/:path*"
    },
    {
      "source": "/projectplan/:path*",
      "destination": "https://nova-plan-omega.vercel.app/projectplan/:path*"
    }
  ]
}