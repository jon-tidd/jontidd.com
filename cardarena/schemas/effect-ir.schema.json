{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jontidd.com/cardarena/schemas/effect-ir.schema.json",
  "title": "CardArena attack effect IR",
  "description": "Structured semantics for one attack. Keyed by attack hash; stores no card text.",
  "type": "object",
  "required": ["hash", "element", "archetype", "damage", "coinFlips", "intensity", "needsReferee"],
  "properties": {
    "hash": { "type": "string", "description": "sha1 of (name|text|damage) — the cache key." },
    "cardIds": { "type": "array", "items": { "type": "string" }, "description": "Cards that carry this exact attack." },
    "element": { "enum": ["Fire", "Water", "Lightning", "Psychic", "Fighting", "Grass", "Darkness", "Metal", "Fairy", "Dragon", "Colorless"] },
    "archetype": { "enum": ["melee", "projectile", "beam", "aoe", "self"] },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "damage": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["fixed", "plus", "times", "none"] },
        "value": { "type": "integer", "minimum": 0 },
        "base": { "type": "integer", "minimum": 0 },
        "perUnit": { "type": "integer", "minimum": 0 },
        "cap": { "type": ["integer", "null"], "minimum": 0 },
        "units": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "enum": ["coinHeads", "energyCount", "damageCounters", "prompt", "constant"] },
            "constant": { "type": "integer", "minimum": 0 },
            "promptLabel": { "type": "string", "maxLength": 40 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coinFlips": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": { "oneOf": [ { "type": "integer", "minimum": 0 }, { "const": "untilTails" } ] },
        "onHeads": { "$ref": "#/$defs/conditional" },
        "onTails": { "$ref": "#/$defs/conditional" }
      },
      "additionalProperties": false
    },
    "status": { "type": ["string", "null"], "enum": ["Asleep", "Burned", "Confused", "Paralyzed", "Poisoned", null] },
    "selfDamage": { "type": "integer", "minimum": 0 },
    "heal": { "type": "integer", "minimum": 0 },
    "needsReferee": { "type": "boolean", "description": "True when v1 cannot evaluate without a human-entered number." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "conditional": {
      "type": "object",
      "properties": {
        "extraDamage": { "type": "integer", "minimum": 0 },
        "status": { "type": ["string", "null"] },
        "attackFails": { "type": "boolean" },
        "selfDamage": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
